{
  "info": {
    "name": "StuxNet - Loja de hardware e periféricos",
    "description": "API em Java 17 sem frameworks (FrontController, Command, Service, DAO e Model). Rode as pastas 01 a 07 em ordem no Collection Runner. Os IDs são salvos sozinhos. Se reiniciar o servidor, os dados em memória somem. A pasta 08 é opcional.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "produtoId", "value": "" },
    { "key": "perifericoId", "value": "" },
    { "key": "produtoTemporarioId", "value": "" },
    { "key": "clienteId", "value": "" },
    { "key": "clienteEmail", "value": "" },
    { "key": "clienteTemporarioId", "value": "" },
    { "key": "enderecoId", "value": "" },
    { "key": "pedidoId", "value": "" },
    { "key": "pedidoExpressoId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Disponibilidade",
      "item": [
        {
          "name": "Saúde da API",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
            "pm.test('API esta UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"
          ] } }]
        }
      ]
    },
    {
      "name": "02 - Produtos",
      "item": [
        {
          "name": "Cadastrar hardware",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/produtos",
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Memória DDR5 16 GB\",\n  \"descricao\": \"Componente de hardware StuxNet\",\n  \"categoria\": \"HARDWARE\",\n  \"preco\": 500,\n  \"estoque\": 10\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) { pm.collectionVariables.set('produtoId', pm.response.json().id); }"
          ] } }]
        },
        {
          "name": "Listar produtos",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/produtos" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Veio uma lista', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
          ] } }]
        },
        {
          "name": "Buscar hardware",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/produtos/{{produtoId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Categoria HARDWARE', function () { pm.expect(pm.response.json().categoria).to.eql('HARDWARE'); });",
            "pm.test('Estoque 10', function () { pm.expect(pm.response.json().estoque).to.eql(10); });"
          ] } }]
        },
        {
          "name": "Atualizar hardware",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/produtos/{{produtoId}}",
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Memória DDR5 16 GB\",\n  \"descricao\": \"Componente de hardware StuxNet\",\n  \"categoria\": \"HARDWARE\",\n  \"preco\": 499.9,\n  \"estoque\": 10\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Preco atualizado', function () { pm.expect(pm.response.json().preco).to.eql(499.9); });"
          ] } }]
        },
        {
          "name": "Cadastrar periférico",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/produtos",
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Mouse USB\",\n  \"categoria\": \"PERIFERICO\",\n  \"preco\": 79.9,\n  \"estoque\": 5\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) { pm.collectionVariables.set('perifericoId', pm.response.json().id); }"
          ] } }]
        },
        {
          "name": "Cadastrar produto temporário",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/produtos",
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Produto temporário\",\n  \"descricao\": \"Componente de hardware StuxNet\",\n  \"categoria\": \"HARDWARE\",\n  \"preco\": 500,\n  \"estoque\": 10\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) { pm.collectionVariables.set('produtoTemporarioId', pm.response.json().id); }"
          ] } }]
        },
        {
          "name": "Excluir produto temporário",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/produtos/{{produtoTemporarioId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 204', function () { pm.response.to.have.status(204); });"
          ] } }]
        },
        {
          "name": "Produto excluído retorna 404",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/produtos/{{produtoTemporarioId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 404', function () { pm.response.to.have.status(404); });"
          ] } }]
        }
      ]
    },
