    {
      "name": "06 - Pedidos e estoque",
      "item": [
        {
          "name": "Criar pedido com hardware e periférico",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/pedidos",
            "body": { "mode": "raw", "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"enderecoId\": {{enderecoId}},\n  \"itens\": [\n    { \"produtoId\": {{produtoId}}, \"quantidade\": 2 },\n    { \"produtoId\": {{perifericoId}}, \"quantidade\": 1 }\n  ]\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) { pm.collectionVariables.set('pedidoId', pm.response.json().id); }",
            "pm.test('Subtotal 1079.7', function () { pm.expect(pm.response.json().subtotal).to.eql(1079.7); });",
            "pm.test('Frete 34.9', function () { pm.expect(pm.response.json().frete).to.eql(34.9); });",
            "pm.test('Total 1114.6', function () { pm.expect(pm.response.json().total).to.eql(1114.6); });",
            "pm.test('Status CRIADO', function () { pm.expect(pm.response.json().status).to.eql('CRIADO'); });"
          ] } }]
        },
        {
          "name": "Listar pedidos",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/pedidos" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
          ] } }]
        },
        {
          "name": "Buscar pedido",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/pedidos/{{pedidoId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Total 1114.6', function () { pm.expect(pm.response.json().total).to.eql(1114.6); });"
          ] } }]
        },
        {
          "name": "Conferir baixa de estoque",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/produtos/{{produtoId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Estoque 8', function () { pm.expect(pm.response.json().estoque).to.eql(8); });"
          ] } }]
        },
        {
          "name": "Estoque insuficiente retorna 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
